{
  "name": "local-oauth-cli-api-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "local-oauth-cli": "./dist/proxy-cli.js"
  },
  "files": [
    "dist/proxy-cli.js",
    "dist/proxy-cli.d.ts",
    "dist/settings.js",
    "dist/settings.d.ts",
    "dist/chat/",
    "dist/proxy/",
    "settings.json",
    "README.md",
    "docs/api-benchmark-design.md",
    "docs/api-interface-contract.md",
    "docs/direct-api-transport-handoff.md",
    "docs/local-cli-chat-api-design.md",
    "docs/optimization-learnings.md",
    "docs/runtime-capability-catalog.md",
    "docs/runtime-capability-update-playbook.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "catalog:runtime": "node scripts/update-runtime-capability-catalog.mjs",
    "smoke:runtime-capabilities": "node scripts/smoke-runtime-capabilities.mjs",
    "probe:codex-backend-image": "node scripts/probe-codex-backend-image.mjs",
    "verify:runtime-boundary": "node scripts/verify-runtime-boundary.mjs",
    "prepack": "pnpm build && pnpm verify:runtime-boundary",
    "pack:adapter": "node scripts/package-adapter.mjs",
    "test:e2e:adapter": "node scripts/e2e-installed-adapter.mjs",
    "test": "pnpm build && pnpm verify:runtime-boundary && node --test --test-concurrency=2 test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proxy:codex": "tsx src/proxy-cli.ts proxy --runtime codex --port 8787",
    "proxy:claude": "tsx src/proxy-cli.ts proxy --runtime claude --port 8788",
    "smoke:real:codex": "pnpm build && node scripts/real-proxy-smoke.mjs --runtime codex",
    "smoke:real:claude": "pnpm build && node scripts/real-proxy-smoke.mjs --runtime claude --model opus",
    "smoke:real:codex:multimodal": "pnpm build && node scripts/real-proxy-smoke.mjs --runtime codex --only multimodal",
    "smoke:real:claude:multimodal": "pnpm build && node scripts/real-proxy-smoke.mjs --runtime claude --model opus --only multimodal",
    "bench:api": "pnpm build && node scripts/api-comparison-benchmark.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
